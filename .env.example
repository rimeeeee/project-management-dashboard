# ---------------------------------------------------------------
# 이 파일을 .env 로 복사해서 쓰세요.  (cp .env.example .env)
# .env 는 git 에 올라가지 않습니다.
# ---------------------------------------------------------------

# 데이터베이스 주소
#   로컬(기본)   : sqlite+pysqlite:///./data/bizdash.db
#   운영(PostgreSQL): postgresql+psycopg://bizdash:비밀번호@localhost:5432/bizdash
DATABASE_URL=sqlite+pysqlite:///./data/bizdash.db

# 로그인 비밀번호의 해시값.
#   아래 명령으로 만들어서 붙여넣으세요:
#     .venv/bin/python scripts/set_password.py
# 비워 두면 개발용 기본 비밀번호(bizdash2026)로 동작하고 서버 시작 시 경고가 뜹니다.
APP_PASSWORD_HASH=

# 세션 쿠키 서명용 비밀키. 운영에서는 반드시 바꾸세요.
#   만드는 법:  .venv/bin/python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me

# 로그인 유지 시간 (시간 단위). '로그인 유지'를 체크하면 REMEMBER_DAYS 가 적용됩니다.
SESSION_HOURS=12
REMEMBER_DAYS=30

# 쿠키를 HTTPS 에서만 보내도록 할지. 운영(https)에서는 true 로 바꾸세요.
COOKIE_SECURE=false

# 개발 중 프론트엔드 주소 (Vite). 운영에서는 한 서버에서 서빙하므로 비워도 됩니다.
CORS_ORIGINS=http://localhost:5173

# 공고 수집.
# 기본은 자동 수집을 끄고, 화면의 [지금 수집] 버튼으로만 받습니다.
# 자동으로 돌리려면 true 로 바꾸세요 (서버가 여러 대면 한 대에서만 켜야 겹치지 않습니다).
COLLECTOR_ENABLED=false
# 자동 수집을 켰을 때의 주기. 분 시 일 월 요일 순서이고,
# 0 6 * * 1,4 는 매주 월·목 오전 6시입니다 (요일: 0=일 1=월 … 6=토).
COLLECTOR_CRON=0 6 * * 1,4

# 기관 게시판(인재원·진흥원·의료정보원)을 며칠 전 게시물까지 가져올지
COLLECT_DAYS=365
# 게시판을 최대 몇 쪽까지 읽을지 (기간을 벗어나면 그 전에 알아서 멈춥니다).
# 진흥원 게시판은 10쪽에서 순환해 그 이상은 같은 내용이 옵니다 — docs/공고수집.md 참고
BOARD_PAGES=12
# NTIS 정기 수집 기간. 과거는 scripts/ntis_backfill.py 로 한 번만 채웁니다
NTIS_DAYS=90
